{}
[(Inspect Inspection)
 (AttemptUpgrade Attempt)
 (Report ReportQuery)
 (AskHandoverMarker MarkerRequest)
 (ReadyToHandover ReadinessReport)
 (HandoverCompleted CompletionReport)
 (Mirror MirrorPayload)
 (Divergence DivergencePayload)
 (RecoverFromFailure RecoveryRequest)]
[(InspectionReported InspectionReported)
 (UpgradeCompleted Completion)
 (UpgradeRejected Rejection)
 (Reported Reported)
 (HandoverMarker HandoverMarker)
 (HandoverAccepted HandoverAcceptance)
 (HandoverFinalized HandoverFinalization)
 (MirrorAcknowledged MirrorAcknowledgement)
 (DivergenceAcknowledged DivergenceAcknowledgement)
 (RecoveryCompleted RecoveryResult)
 (HandoverRejected HandoverRejection)
 (RequestUnimplemented RequestUnimplemented)]
{
  ComponentName String
  MigrationIdentifier String
  RecordKind String
  RawByte Integer
  RawBytes (Vector RawByte)
  ChangedRecords Integer
  StateSequence Integer
  MirroredWriteCount Integer
  RecordFrontier (Optional Integer)
  FailureIdentifier Integer
  DivergenceIdentifier Integer
  Recovered Boolean
  SupportedMigrations (Vector SupportedMigration)
  Completions (Vector Completion)
  Rejections (Vector Rejection)
  ContractVersion { RawBytes }
  Version { major.Integer minor.Integer patch.Integer }
  SupportedMigration { ComponentName source.Version target.Version MigrationIdentifier }
  Inspection [All (Component ComponentName)]
  Attempt { ComponentName source.Version target.Version }
  ReportQuery [All (Component ComponentName)]
  InspectionReported { SupportedMigrations }
  Completion { ComponentName source.Version target.Version MigrationIdentifier ChangedRecords }
  RejectionReason [UnsupportedMigration ComponentMismatch MigrationFailed]
  Rejection { ComponentName source.Version target.Version RejectionReason }
  Reported { Completions Rejections }
  UnimplementedReason [NotBuiltYet IntegrationNotLanded]
  RequestUnimplemented { UnimplementedReason }
  Date { year.Integer month.Integer day.Integer }
  Time { hour.Integer minute.Integer second.Integer }
  HandoverMarker { ComponentName ContractVersion StateSequence MirroredWriteCount RecordFrontier Date Time }
  MarkerRequest { ComponentName }
  ReadinessReport { ComponentName HandoverMarker }
  CompletionReport { ComponentName HandoverMarker }
  MirrorPayload { ComponentName source_version.ContractVersion target_version.ContractVersion RecordKind RawBytes }
  DivergencePayload { ComponentName source_version.ContractVersion target_version.ContractVersion DivergenceReason RecordKind RawBytes }
  RecoveryRequest { ComponentName FailureIdentifier }
  HandoverAcceptance { HandoverMarker }
  HandoverFinalization { HandoverMarker }
  MirrorAcknowledgement { ComponentName MirroredWriteCount }
  DivergenceAcknowledgement { ComponentName DivergenceIdentifier }
  RecoveryResult { ComponentName Recovered }
  HandoverRejection { ComponentName HandoverRejectionReason }
  HandoverRejectionReason [SchemaMismatch StateSequenceAdvanced AlreadyInHandover NotReady]
  DivergenceReason [NotRepresentable TargetUnavailable TargetRejected]
}
